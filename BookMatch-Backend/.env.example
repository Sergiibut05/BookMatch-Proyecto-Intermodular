PORT=3000
NODE_ENV=development
JWT_SECRET=supersecreta_cambia_esto
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
BCRYPT_SALT_ROUNDS=10

# URL pública del backend (ngrok en dev, dominio real en prod). n8n la usará
# como callbackUrl para escribir de vuelta los resultados de IA.
# BACKEND_PUBLIC_URL=https://tu-dominio-publico.com

# URL del webhook de n8n para el chat con IA (opcional). Ejemplo:
# N8N_WEBHOOK_URL=https://sergii05.app.n8n.cloud/webhook/TU_ID_REAL_DE_WEBHOOK

# --- H1.3 · Generación de playlists con IA ---
# URL del webhook de n8n que genera playlists desde un prompt del usuario.
# N8N_WEBHOOK_PLAYLIST_URL=https://sergii05.app.n8n.cloud/webhook/TU_ID_PLAYLIST
# Secret compartido con n8n: se comprueba en el header x-n8n-secret del callback.
# N8N_CALLBACK_SECRET=cambia-esto-por-un-secret-fuerte
