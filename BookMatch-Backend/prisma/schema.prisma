// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

// ---------------------------------------------------------------------------
// Trades / Trueque (Epic A)
// ---------------------------------------------------------------------------

enum TradeStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum TradeSide {
  SENDER
  RECEIVER
}

enum BookCondition {
  NEW
  LIKE_NEW
  GOOD
  ACCEPTABLE
  WORN
}

model User {
  id          Int     @id @default(autoincrement())
  firebaseUid String  @unique @map("firebase_uid")
  email       String  @unique
  fullName    String? @map("full_name")
  avatarUrl   String? @map("avatar_url")
  phone       String?

  role Role @default(USER) @map("role")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userBooks UserBook[]
  orders    Order[]
  reviews   Review[]

  createdForums Forum[]   @relation("UserForums")
  posts         Post[]
  comments      Comment[]
  votes         Vote[]

  playlists Playlist[]

  sentTrades     Trade[] @relation("TradeSender")
  receivedTrades Trade[] @relation("TradeReceiver")
  @@map("users")
}

model Category {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  slug        String       @unique
  type        CategoryType
  parentId    Int?         @map("parent_id")
  icon        String?
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]            @relation("CategoryHierarchy")
  catalogBooks CatalogBookCategory[]
  userBooks    UserBookCategory[]

  @@map("categories")
}

enum CategoryType {
  MAIN
  SPECIAL
}

model CatalogBook {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  isbn        String   @unique
  description String?
  coverUrl    String?  @map("cover_url")
  imageUrls   String[] @default([])
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderItems    OrderItem[]
  reviews       Review[]
  categories    CatalogBookCategory[]
  playlistItems PlaylistItem[]
  userBooks     UserBook[]

  @@map("catalog_books")
}

model CatalogBookCategory {
  id            Int      @id @default(autoincrement())
  catalogBookId Int      @map("catalog_book_id")
  categoryId    Int      @map("category_id")
  createdAt     DateTime @default(now()) @map("created_at")

  catalogBook CatalogBook @relation(fields: [catalogBookId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([catalogBookId, categoryId])
  @@map("catalog_book_categories")
}

model UserBook {
  id             Int            @id @default(autoincrement())
  title          String
  author         String
  isbn           String?
  description    String?
  coverUrl       String?        @map("cover_url")
  imageUrls      String[]       @default([])
  condition      BookCondition  @default(GOOD)
  catalogBookId  Int?           @map("catalog_book_id")
  ownerId        Int            @map("owner_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  catalogBook CatalogBook? @relation(fields: [catalogBookId], references: [id], onDelete: SetNull)
  categories  UserBookCategory[]
  tradeItems  TradeItem[]

  @@index([catalogBookId])
  @@map("user_books")
}

model Trade {
  id         Int         @id @default(autoincrement())
  status     TradeStatus @default(PROPOSED)
  senderId   Int         @map("sender_id")
  receiverId Int         @map("receiver_id")
  message    String?
  expiresAt  DateTime?   @map("expires_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  sender   User        @relation("TradeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User        @relation("TradeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  items    TradeItem[]

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("trades")
}

model TradeItem {
  id         Int       @id @default(autoincrement())
  tradeId    Int       @map("trade_id")
  userBookId Int       @map("user_book_id")
  side       TradeSide
  createdAt  DateTime  @default(now()) @map("created_at")

  trade    Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  @@unique([tradeId, userBookId])
  @@index([tradeId])
  @@index([userBookId])
  @@map("trade_items")
}

model UserBookCategory {
  id         Int      @id @default(autoincrement())
  userBookId Int      @map("user_book_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userBookId, categoryId])
  @@map("user_book_categories")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int         @map("user_id")
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  status          OrderStatus @default(PENDING)
  paymentIntentId String?     @map("payment_intent_id")
  shippingAddress String?     @map("shipping_address")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int     @map("order_id")
  catalogBookId Int     @map("catalog_book_id")
  quantity      Int     @default(1)
  price         Decimal @db.Decimal(10, 2)

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogBook CatalogBook @relation(fields: [catalogBookId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Review {
  id            Int      @id @default(autoincrement())
  catalogBookId Int      @map("catalog_book_id")
  userId        Int      @map("user_id")
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  catalogBook CatalogBook @relation(fields: [catalogBookId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([catalogBookId, userId])
  @@map("reviews")
}

model Forum {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relación con el usuario creador
  creatorId Int  @map("creator_id")
  creator   User @relation("UserForums", fields: [creatorId], references: [id], onDelete: Cascade)

  // Un foro tiene muchas publicaciones
  posts Post[]

  @@map("forums")
}

model PostImage {
  id        Int      @id @default(autoincrement())
  url       String // URL de la imagen
  postId    Int      @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_images")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text // @db.Text permite textos largos
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relación con el Foro
  forumId Int   @map("forum_id")
  forum   Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)

  // Relación con el Usuario creador
  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Una publicación tiene muchos comentarios
  comments Comment[]

  images PostImage[]

  score Int    @default(0)
  votes Vote[]

  @@map("posts")
}

enum VoteType {
  UP
  DOWN
}

model Vote {
  id     Int      @id @default(autoincrement())
  userId Int      @map("user_id")
  postId Int      @map("post_id")
  type   VoteType // UP o DOWN

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Asegura que un usuario solo tenga UN voto por publicación.
  // Si intenta votar de nuevo, el sistema te obligará a actualizar este registro
  @@unique([userId, postId])
  @@map("votes")
}

// ---------------------------------------------------------------------------
// Playlists (AI + manuales) — SCRUM-160 (H1.1) bajo SCRUM-158
// ---------------------------------------------------------------------------

enum PlaylistVisibility {
  PRIVATE
  PUBLIC
}

enum PlaylistSource {
  MANUAL
  AI
  HYBRID
}

enum ItemStatus {
  PENDING
  READING
  READ
}

model Playlist {
  id          Int                @id @default(autoincrement())
  ownerId     Int                @map("owner_id")
  title       String
  description String?
  coverUrl    String?            @map("cover_url")
  visibility  PlaylistVisibility @default(PRIVATE)
  source      PlaylistSource     @default(MANUAL)
  aiPrompt    String?            @map("ai_prompt")
  shareToken  String?            @unique @map("share_token")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([ownerId])
  @@map("playlists")
}

model PlaylistItem {
  id            Int        @id @default(autoincrement())
  playlistId    Int        @map("playlist_id")
  catalogBookId Int        @map("catalog_book_id")
  position      Int
  status        ItemStatus @default(PENDING)
  note          String?
  addedAt       DateTime   @default(now()) @map("added_at")

  playlist    Playlist    @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  catalogBook CatalogBook @relation(fields: [catalogBookId], references: [id])

  @@unique([playlistId, catalogBookId])
  @@index([playlistId, position])
  @@map("playlist_items")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relación con la Publicación (Post)
  postId Int  @map("post_id")
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Relación con el Usuario creador
  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // --- RELACIÓN RECURSIVA (Respuestas a comentarios) ---
  // parentId puede ser null si es un comentario principal
  parentId Int?     @map("parent_id")
  parent   Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)

  // Hijos (respuestas a este comentario)
  children Comment[] @relation("CommentReplies")

  @@map("comments")
}
