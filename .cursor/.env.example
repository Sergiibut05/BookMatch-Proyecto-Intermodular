# n8n MCP (czlonkowski/n8n-mcp) — copia a .cursor/.env (no commitear)
# También puedes poner estas variables en .env (raíz) o BookMatch-Backend/.env

# URL base de tu instancia n8n (sin /webhook/...). Ejemplo n8n Cloud:
# N8N_API_URL=https://tu-instancia.app.n8n.cloud
N8N_API_URL=

# API key: n8n → Settings → n8n API → Create an API key
N8N_API_KEY=

# Opcional: si ya tienes webhooks en el backend, N8N_API_URL se deduce del origin
# N8N_WEBHOOK_URL=https://tu-instancia.app.n8n.cloud/webhook/...
